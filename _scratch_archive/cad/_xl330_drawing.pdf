	<script>

		var httpCode = '200';

		function sleep(num){	//[1/1000초]
			var now = new Date();
			var stop = now.getTime() + num;
			while(true){
				now = new Date();
				 if(now.getTime() > stop)return;

			}
		}

		function call_url(url){
			sleep(2000);
			location.href=url;
		}

		if(httpCode =="200" || httpCode =="302" || httpCode =="301"){ //성공
			call_url('https://www.dropbox.com/s/gxgye7wt5sbt4i4/XL,XC-330.pdf?dl=1');
		}


	</script>

