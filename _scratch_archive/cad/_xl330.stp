	<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
	<html xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1;" charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, target-densitydpi=medium-dpi" />
		<title>ROBOTIS</title>
	</head>

	<body>  

		<style>

			.downloadbox { background-color:#ffffff; margin:0;  } 

			.downloadbox  .sub_inner { width:90%; max-width:700px; margin:0 auto;  }
			.downloadbox  .sub_inner .tit { margin:0 auto; padding:30px 0 5px 0; font-size: 3em;  font-family: 'sans-serif'; font-weight:bold; line-height:1.2em; }
			.downloadbox  .sub_inner .desc { margin-bottom:20px; font-size: 1.5em; color:#6e4f42; font-family:'sans-serif';  }
			.downloadbox  .sub_inner .subject { font-size: 2em;  border-bottom:1px solid #ded4c8; padding-bottom:5px; font-family: 'sans-serif' ; }
			.downloadbox  .sub_inner .bonmoon { font-size:1em; text-align:left; line-height:1.5em;  } 

			.downloadbox .welcome_msg .welcome_img { float:left; width: 35%; }
			.downloadbox .welcome_msg .welcome_img img { width: 80%; }
			.downloadbox .welcome_msg .welcome_txt { float:left; width: 60%; box-sizing:border-box; padding:30px 0px;  text-align:left; }
			.downloadbox .welcome_msg .welcome_txt .bonmoon_box  { clear:left; width:100%; padding: 0;  margin-top:20px; }

			.downloadbox  .sub_inner .path_box {background-color:#f0f0f0; padding:20px; text-align:left; clear:both; }
			.downloadbox  .sub_inner .path_box a { text-decoration:none;}

			.downloadbox  .sub_inner .banner {width:100%;  }
			.downloadbox  .sub_inner .banner img {width:100%; margin-top:80px;}


		</style>


		<div class="body_wrap downloadbox">  

			
				<div class="sub_inner center">  

					<div class="welcome_msg">
						<div class="welcome_img"><img src="https://en.robotis.com/img/common/download_20171016.jpg" ></div>
						<div class="welcome_txt">
							<span class="tit">ROBOTIS  DOWNLOAD</span> 
									
							<div class="bonmoon_box">

								
									<span class="bonmoon">	
										Your download will start shortly..<br />
										Problems with the download?  Please use the direct link below.
									</span>

															</div>

						</div>
					</div>

					<div class="path_box">
						Direct Link  : <a href="https://en.robotis.com/service/download.php?no=1987" target="_self">https://en.robotis.com/service/download.php?no=1987</a> <br>
                        <br>Direct Link 2 (China) : <a href="#" onclick="downLink()">Download</a>
					</div>

					<div class="banner">
					
													
												</div>
					
				</div>


		</div>

	</body>

	
	<script>

		var httpCode = '200';
        var no = '1987';
        var fileSize = '0';
		

		function sleep(num){	//[1/1000초]
			var now = new Date();
			var stop = now.getTime() + num;
			while(true){
				now = new Date();
				 if(now.getTime() > stop)return;

			}
		}

		function call_url(url){
			sleep(2000);
			location.href=url;
		}

		if(httpCode =="200" || httpCode =="302" || httpCode =="301" ){ //성공
			call_url('https://www.dropbox.com/s/qlzmp8mlvzrxmzu/XL,XC-330.stp?dl=1');
		}

        var downLink = function () {
            var ajax_url = "./ajax_direct_file_upload_check.php?no="+no+"&fileSize="+fileSize;
            var ajax_data = "";

            $.ajax({
                async: false,
                type: "POST",
                url: ajax_url,
                data : ajax_data,
                dataType: 'jsonp',
                jsonpCallback: "callback",
                success: function (jsonData) {
                    if(jsonData.code == 200) {
                        document.location.href = 'direct_download.php?no=' + jsonData.return_val.no;
                    } else if(jsonData.code == 202) {
                        // 파일 사이즈 체크
                        fileSize = jsonData.return_val.fileSize;
                        sleep(2000);
                        console.log('wait');
                        downLink();
                    } else {
                        alert('File Error');
                    }
                    console.log(jsonData);
                },
                error:function(request, status, error){
                    alert('Link Error');
                    console.log( "code : " + request.status + "\n message : " + request.responseText + "\n" + error);
                }
            });
        }

	</script>

	</html>


